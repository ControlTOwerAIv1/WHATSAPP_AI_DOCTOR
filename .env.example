# ===================================================================
# WhatsApp Relay — Environment Variables Example Template
# Copy this file to .env and fill in your values
# ===================================================================

# ── Meta WhatsApp Cloud API ─────────────────────────────────────────
# Permanent System User Access Token or Temporary Developer Token
# (Obtain from Meta Developer Console > WhatsApp > API Setup)
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token_here

# WhatsApp Business Phone Number ID (from Meta Developer Console > WhatsApp > API Setup)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# WhatsApp Business Account ID (WABA ID) (Optional)
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id_here

# Custom Webhook Verification Token (set this same secret string in Meta Webhook config)
WHATSAPP_VERIFY_TOKEN=echo-relay-verify-token

# Meta Graph API Version (defaults to v21.0)
GRAPH_API_VERSION=v21.0

# Meta App Secret — REQUIRED for webhook signature verification (X-Hub-Signature-256)
# Find it in Meta App Dashboard > Settings > Basic
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# ── Server Port ────────────────────────────────────────────────────
PORT=3001

# ── Anthropic Claude LLM (AI Chatbot) ──────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── AI Bot Feature Toggle & Admin Config ───────────────────────────
AI_BOT_ENABLED=true
ADMIN_PHONE_NUMBER=919876543200

# ── Whisper Transcription Server (Voice Notes) ─────────────────────
# Model size: tiny, base, small, medium, large (default: small)
WHISPER_MODEL=small
WHISPER_PORT=5555

# ── Echo Dashboard Login ────────────────────────────────────────────
# Generate the password hash with:  node scripts/gen-hash.js
# No default password is shipped — you MUST set these before running.
ECHO_ADMIN_USER=admin
ECHO_ADMIN_PASSWORD_HASH=

# ── AWS S3 Backups (optional) ───────────────────────────────────────
# Leave blank to skip S3 upload; backups are still saved locally in backups/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BACKUP_BUCKET=
