# ===================================================================
# WhatsApp AI Doctor — Environment Variables
# ===================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# ===================================================================

# ── WhatsApp / Meta Cloud API ──────────────────────────────────────
# Get these from Meta Business Platform → WhatsApp → API Setup
# https://developers.facebook.com/apps/
APP_WHATSAPP_VERIFY_TOKEN=whatsapp-ai-doctor-verify
APP_WHATSAPP_ACCESS_TOKEN=your_meta_access_token_here
APP_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
APP_WHATSAPP_API_VERSION=v21.0

# ── Ollama LLM ─────────────────────────────────────────────────────
# Local LLM inference — no API key needed
# Models: llama3.1:8b (default), qwen2.5:7b, phi3:mini (lighter)
APP_OLLAMA_BASE_URL=http://ollama:11434
APP_OLLAMA_MODEL=llama3.1:8b
APP_OLLAMA_TIMEOUT=120

# ── PostgreSQL ─────────────────────────────────────────────────────
APP_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/whatsapp_doctor

# ── Redis ──────────────────────────────────────────────────────────
APP_REDIS_URL=redis://redis:6379/1

# ── Qdrant (Vector DB for RAG) ─────────────────────────────────────
APP_QDRANT_HOST=qdrant
APP_QDRANT_PORT=6333
APP_QDRANT_COLLECTION=patient_history

# ── Voice Service ──────────────────────────────────────────────────
APP_VOICE_SERVICE_URL=http://voice-service:8000

# ── Celery Task Queue ──────────────────────────────────────────────
APP_CELERY_BROKER_URL=redis://redis:6379/1
APP_CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Core API General ──────────────────────────────────────────────
APP_LOG_LEVEL=info
APP_DEBUG=false
APP_ENVIRONMENT=development

# ── Voice Service Overrides ────────────────────────────────────────
# Only needed if you want to override voice-service defaults
VOICE_OPENAI_API_KEY=dummy
VOICE_TTS_PROVIDER=edge
VOICE_WHISPER_MODEL_SIZE=tiny
