# ===================================================================
# WhatsApp AI Doctor — Environment Variables
# ===================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# ===================================================================

# ── Anthropic Claude LLM ──────────────────────────────────────────
# Get your key from https://console.anthropic.com/
APP_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Google Sheets (Availability + Bookings) ────────────────────────
# 1. Create a Google Cloud service account
# 2. Enable the Google Sheets API
# 3. Download the credentials JSON file
# 4. Create a Google Sheet and share it with the service account email
APP_GOOGLE_CREDENTIALS_FILE=credentials.json
APP_GOOGLE_SHEET_ID=your_google_sheet_id_here

# ── Twilio WhatsApp Sandbox ────────────────────────────────────────
# Get these from https://console.twilio.com/
APP_TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
APP_TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# ── WhatsApp / Meta Cloud API (optional, for production) ──────────
# These are not needed for the Twilio sandbox demo.
# Get from Meta Business Platform → WhatsApp → API Setup
APP_WHATSAPP_VERIFY_TOKEN=whatsapp-ai-doctor-verify
APP_WHATSAPP_ACCESS_TOKEN=
APP_WHATSAPP_PHONE_NUMBER_ID=
APP_WHATSAPP_API_VERSION=v21.0

# ── General ───────────────────────────────────────────────────────
APP_LOG_LEVEL=info
APP_DEBUG=false
APP_ENVIRONMENT=development
