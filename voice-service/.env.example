# ===================================================================
# Voice Processing Microservice — Environment Configuration
# ===================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# ===================================================================

# ── STT (Speech-to-Text) ───────────────────────────────────────────
# Model size: tiny, base, small, medium, large-v3, large-v3-turbo
VOICE_WHISPER_MODEL_SIZE=tiny
VOICE_WHISPER_DEVICE=cpu
VOICE_WHISPER_COMPUTE_TYPE=int8
VOICE_WHISPER_BEAM_SIZE=5
# Set to a language code (e.g., "en") to force language, or leave empty for auto-detect
VOICE_WHISPER_LANGUAGE=

# ── Translation ─────────────────────────────────────────────────────
VOICE_LIBRETRANSLATE_URL=http://libretranslate:5000
VOICE_TRANSLATION_TARGET_LANGUAGE=en
VOICE_TRANSLATION_ENABLED=false
    VOICE_TRANSLATION_TIMEOUT_SECONDS=10
VOICE_TRANSLATION_CIRCUIT_BREAKER_THRESHOLD=3
VOICE_TRANSLATION_CIRCUIT_BREAKER_RESET_SECONDS=60

# ── TTS (Text-to-Speech) ───────────────────────────────────────────
# REQUIRED: Get your API key from https://platform.openai.com/api-keys
VOICE_OPENAI_API_KEY=dummy  
VOICE_TTS_MODEL=tts-1
VOICE_TTS_DEFAULT_VOICE=onyx
VOICE_TTS_VOICE_MAPPING=doctor:onyx,patient:nova,system:alloy

# ── Storage ─────────────────────────────────────────────────────────
VOICE_AUDIO_STORAGE_PATH=./storage/audio
VOICE_GENERATED_STORAGE_PATH=./storage/generated
VOICE_BASE_URL=http://localhost:8000

# ── Audio Validation ────────────────────────────────────────────────
VOICE_MAX_AUDIO_DURATION_SECONDS=60
VOICE_MAX_AUDIO_FILE_SIZE_MB=25
VOICE_AUDIO_DOWNLOAD_TIMEOUT_SECONDS=30

# ── Celery ──────────────────────────────────────────────────────────
VOICE_CELERY_BROKER_URL=redis://redis:6379/0
VOICE_CELERY_RESULT_BACKEND=redis://redis:6379/0
VOICE_CELERY_TASK_TIME_LIMIT=120
VOICE_CELERY_TASK_SOFT_TIME_LIMIT=90

# ── ffmpeg ──────────────────────────────────────────────────────────
VOICE_FFMPEG_PATH=ffmpeg
VOICE_FFPROBE_PATH=ffprobe
VOICE_FFMPEG_TIMEOUT_SECONDS=30

# ── General ─────────────────────────────────────────────────────────
VOICE_LOG_LEVEL=INFO
VOICE_DEBUG=false
VOICE_ENVIRONMENT=development
